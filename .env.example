# ==============================================================================
# SafShekan (صف‌شکن) Environment Configuration
# Enterprise TSE Trading Engine & Platform
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000

# PostgreSQL 17 Database
# Format: postgres://<user>:<password>@<host>:<port>/<database>
POSTGRES_DB=safshekan_db
POSTGRES_USER=safshekan
POSTGRES_PASSWORD=replace_with_a_secure_postgres_password_32_chars
DATABASE_URL=postgres://safshekan:replace_with_a_secure_postgres_password_32_chars@postgres:5432/safshekan_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=10000

# Redis 7 (Cache, Coordination, Queues)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_a_secure_redis_password_32_chars
REDIS_DB=0
# Sizing: use 128mb for VPS < 2GB RAM, or 256mb for >= 2GB RAM
REDIS_MAXMEMORY=128mb

# AES-256-GCM Envelope Encryption Master Key
# Must be exactly 64 hex characters (32 bytes / 256 bits)
# Generate with: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENCRYPTION_KEY_VERSION=1

# Asymmetric Ed25519 JWT Authentication & Sessions
# Generate Ed25519 keypair:
#   openssl genpkey -algorithm Ed25519 -out ed25519_private.pem
#   openssl pkey -in ed25519_private.pem -pubout -out ed25519_public.pem
JWT_KEY_ID=safshekan-ed25519-v1
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIFX+dummy_ed25519_private_key_pem_format\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAFX+dummy_ed25519_public_key_pem_format\n-----END PUBLIC KEY-----"

# CSRF Protection
CSRF_ALLOWED_ORIGINS=https://localhost:3000,http://localhost:3000

# Initial Admin Bootstrap (Optional for non-interactive seed)
# If not set, use: pnpm --filter @saf-shekan/backend cli create-admin
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_EMAIL=admin@safshekan.local

# External Services & Monitoring
PROMETHEUS_METRICS_ENABLED=true
METRICS_AUTH_TOKEN=replace_with_secure_internal_metrics_bearer_token
LOG_LEVEL=info
