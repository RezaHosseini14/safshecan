# Multi-stage production build for SafShekan Next.js Frontend Dashboard
FROM public.ecr.aws/docker/library/node:22-alpine AS base
RUN npm install -g pnpm@9.15.0 turbo
WORKDIR /app

# Stage 1: Pruning monorepo for Frontend
FROM base AS pruner
COPY . .
RUN turbo prune @saf-shekan/frontend --docker

# Stage 2: Install dependencies & build
FROM base AS builder
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile

COPY --from=pruner /app/out/full/ .
ENV NEXT_TELEMETRY_DISABLED=1
RUN turbo run build --filter=@saf-shekan/frontend

# Stage 3: Production Frontend Runner
FROM public.ecr.aws/docker/library/node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm install -g pnpm@9.15.0 \
  && addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 nextjs

COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /app/packages ./packages
COPY --from=builder --chown=nextjs:nodejs /app/apps/frontend ./apps/frontend

USER nextjs
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

WORKDIR /app/apps/frontend
CMD ["pnpm", "start", "-p", "3000", "-H", "0.0.0.0"]
