{
  "name": "@saf-shekan/api",
  "version": "1.0.0",
  "description": "SafShekan Backend API & High-Speed Trading Engine with NestJS",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node dev.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "cli": "tsx src/cli.ts",
    "backtest": "tsx src/run-backtest.ts",
    "backtest:historical": "tsx src/run-historical-backtest.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/platform-ws": "^12.1.2",
    "@nestjs/serve-static": "^12.0.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.1.2",
    "@saf-shekan/core": "workspace:*",
    "chalk": "^5.4.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "open": "^10.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "tse-client": "^2.27.6",
    "undici": "^6.21.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@saf-shekan/tsconfig": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.5.13",
    "rimraf": "^6.0.1",
    "supertest": "^7.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3"
  }
}
